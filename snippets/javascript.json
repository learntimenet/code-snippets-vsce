{
  "Console Log": {
    "prefix": "cl",
    "description": "console.log with label",
    "body": "console.log('${1:value}:', ${1:value});$0"
  },
  "Arrow Function": {
    "prefix": "af",
    "description": "Arrow function",
    "body": [
      "const ${1:name} = (${2:params}) => {",
      "  $0",
      "};"
    ]
  },
  "Async Function": {
    "prefix": "async",
    "description": "Async function with try/catch",
    "body": [
      "async function ${1:name}(${2:params}) {",
      "  try {",
      "    $0",
      "  } catch (error) {",
      "    console.error(error);",
      "  }",
      "}"
    ]
  },
  "Fetch JSON": {
    "prefix": "fj",
    "description": "Fetch and parse JSON with async/await",
    "body": [
      "const response = await fetch('${1:/api/endpoint}');",
      "if (!response.ok) {",
      "  throw new Error(`HTTP ${response.status}`);",
      "}",
      "const ${2:data} = await response.json();$0"
    ]
  },
  "Try Catch": {
    "prefix": "tc",
    "description": "try/catch block",
    "body": [
      "try {",
      "  $1",
      "} catch (${2:error}) {",
      "  $0",
      "}"
    ]
  },
  "Destructure Object": {
    "prefix": "do",
    "description": "Object destructuring",
    "body": "const { $2 } = ${1:object};$0"
  },
  "Destructure Array": {
    "prefix": "da",
    "description": "Array destructuring",
    "body": "const [$2] = ${1:array};$0"
  },
  "Import Named": {
    "prefix": "im",
    "description": "Named import",
    "body": "import { $2 } from '${1:module}';$0"
  },
  "Import Default": {
    "prefix": "imd",
    "description": "Default import",
    "body": "import ${2:name} from '${1:module}';$0"
  },
  "For Of Loop": {
    "prefix": "forof",
    "description": "for...of loop",
    "body": [
      "for (const ${2:item} of ${1:items}) {",
      "  $0",
      "}"
    ]
  },
  "Array Map": {
    "prefix": "amap",
    "description": "Array map",
    "body": "const ${3:result} = ${1:array}.map((${2:item}) => $0);"
  },
  "Array Filter": {
    "prefix": "afilter",
    "description": "Array filter",
    "body": "const ${3:result} = ${1:array}.filter((${2:item}) => $0);"
  },
  "Array Reduce": {
    "prefix": "areduce",
    "description": "Array reduce",
    "body": "const ${3:result} = ${1:array}.reduce((${4:acc}, ${2:item}) => {\n  $0\n  return ${4:acc};\n}, ${5:initial});"
  },
  "Promise": {
    "prefix": "promise",
    "description": "New Promise",
    "body": [
      "new Promise((resolve, reject) => {",
      "  $0",
      "});"
    ]
  },
  "Set Timeout": {
    "prefix": "st",
    "description": "setTimeout",
    "body": [
      "setTimeout(() => {",
      "  $0",
      "}, ${1:1000});"
    ]
  },
  "Debounce": {
    "prefix": "debounce",
    "description": "Debounce helper function",
    "body": [
      "function debounce(fn, delay = ${1:300}) {",
      "  let timer;",
      "  return (...args) => {",
      "    clearTimeout(timer);",
      "    timer = setTimeout(() => fn(...args), delay);",
      "  };",
      "}$0"
    ]
  },
  "Class": {
    "prefix": "class",
    "description": "ES6 class with constructor",
    "body": [
      "class ${1:${TM_FILENAME_BASE}} {",
      "  constructor(${2:params}) {",
      "    $0",
      "  }",
      "}"
    ]
  },
  "Event Listener": {
    "prefix": "el",
    "description": "addEventListener",
    "body": [
      "${1:element}.addEventListener('${2:click}', (${3:event}) => {",
      "  $0",
      "});"
    ]
  },
  "Query Selector": {
    "prefix": "qs",
    "description": "document.querySelector",
    "body": "const ${2:el} = document.querySelector('${1:selector}');$0"
  }
}
